# Configuración del servidor SMTP
SMTP_HOST=smtp.example.com  # Servidor SMTP (ejemplo: smtp.gmail.com)
SMTP_USERNAME=usuario@example.com  # Tu dirección de correo electrónico SMTP
SMTP_PASSWORD=tu_contraseña_smtp  # Tu contraseña de aplicación SMTP
SMTP_PORT=587  # Puerto SMTP (ejemplo: 587 para TLS, 465 para SSL)

# Configuración de la base de datos
DB_HOST=localhost # El host de tu servidor de base de datos
DB_USERNAME=usuario # El nombre de usuario para conectar a la base de datos
DB_PASSWORD=contraseña # La contraseña para conectar a la base de datos
DB_DATABASE=nombre_de_la_base_de_datos # El nombre de la base de datos

# Configuración de la aplicación
APP_URL=http://localhost/Encriptacion_PHP/public
APP_TIMEZONE=America/Bogota

# Configuración de caché
CACHE_ENABLED=true
CACHE_TTL_USERS=60 # Tiempo de vida en segundos para la lista de usuarios
CACHE_DRIVER=file # file | redis (con redis caído la app sigue sin caché)
CACHE_VERSION=v1 # Subirlo (v2, v3...) invalida toda la caché de Redis sin FLUSHDB
SESSION_DRIVER=file # file | redis (con redis caído las sesiones vuelven a archivos)

# Redis/Valkey (se usa con CACHE_DRIVER=redis, SESSION_DRIVER=redis o LOGIN_IP_THROTTLE_ENABLED=true; requiere ext-redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME= # Usuario ACL (opcional)
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=encphp: # Solo [a-z0-9_:-]
REDIS_CONNECT_TIMEOUT=0.2 # Segundos
REDIS_READ_TIMEOUT=0.5 # Segundos

# Remember Me
REMEMBER_ME_ENABLED=true
REMEMBER_ME_TTL=2592000

# Session timeout (inactividad)
SESSION_TIMEOUT=1800

# Gestión de sesiones activas (revocación de sesiones)
ACTIVE_SESSIONS_ENABLED=true

# Account lockout
LOGIN_LOCKOUT_ENABLED=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

LOGIN_IP_THROTTLE_ENABLED=false # Límite de intentos por IP; requiere Redis operativo (sin Redis no limita)
LOGIN_IP_MAX_ATTEMPTS=20
LOGIN_IP_WINDOW=900 # Segundos

# Google OAuth 2.0 / OpenID Connect — habilitar solo tras registrar
# un cliente OAuth en Google Cloud Console (Web application) y autorizar
# OAUTH_GOOGLE_REDIRECT_URI como redirect URI permitida.
OAUTH_GOOGLE_ENABLED=false # true habilita el botón "Continue with Google" y las rutas /auth/google*
OAUTH_GOOGLE_CLIENT_ID= # Client ID de la credencial OAuth (ej: 123456789-abcdef.apps.googleusercontent.com)
OAUTH_GOOGLE_CLIENT_SECRET= # Client Secret de la misma credencial — nunca committear llaves reales
OAUTH_GOOGLE_REDIRECT_URI=http://localhost/Encriptacion_PHP/public/auth/google/callback

# Versión de la aplicación
APP_VERSION=1.17.0
